# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/webhub-crm?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d

# Frontend Static Site URL (for CORS)
# Example: https://webhub-client.onrender.com
FRONTEND_URL=https://<your-client-site-name>.onrender.com
